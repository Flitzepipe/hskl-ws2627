# make sub-makes silent
!CMDSWITCHES +s

SUBDIRS = lib ppc00 ppc01 ppc02 ppc03 ppc04 ppc05 ppc06 ppc07 ppc08 ppc09 ppc10 ppc20 ppc21 ppc22 ppcA00 ppcA01 ppcA02 ppcA03 ppcA04 ppcA05 ppcA06 ppcA07 ppcA08 ppcA09 ppcA10 ppcA11 ppcA12 ppcA13

all clean::
 @for %%i in ($(SUBDIRS)) do @( \
	 echo Making $@ in %%i ... & \
	 cd %%i && \
	 $(MAKE) /f nmake /nologo /$(MAKEFLAGS) $@ & \
	 cd .. \
 )
