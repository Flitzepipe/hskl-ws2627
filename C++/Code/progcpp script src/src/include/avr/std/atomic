#pragma once

#include <util/atomic.h>
#include <avr/interrupt.h>
#include <avr/cpufunc.h>
#include <cstdint>
#include <type_traits>
#include <concepts>
#include <avr/memory.h>

namespace std {
    struct UnSafe;
    
    template<typename T>
    class atomic;

    template<std::integral T>
    class atomic<T> {
    public:
        constexpr atomic() = default;
        atomic(const atomic&) = delete;
        void operator=(const atomic &) = delete;

        void operator=(const T v) {
            Atomic::DisableInterruptsRestore di;
            mValue = v;
        }
        template<typename K = void>
        void operator++() volatile {
            if constexpr(std::is_same_v<K, UnSafe>) {
                ++mValue;
            }
            else {
                Atomic::DisableInterruptsRestore di;
                ++mValue; // <> read-modify-write: possible lost-update -> DisableInterrupts
            }
        }
        template<typename K = void>
        void operator++() {
            if constexpr(std::is_same_v<K, UnSafe>) {
                ++mValue;
            }
            else {
                Atomic::DisableInterruptsRestore di;
                ++mValue; // <> read-modify-write: possible lost-update -> DisableInterrupts
            }
        }
        template<typename K = void>
        void operator+=(const T v) {
            if constexpr(std::is_same_v<K, UnSafe>) {
                mValue += v;
            }
            else {
                Atomic::DisableInterruptsRestore di;
                mValue += v; // <> read-modify-write: possible lost-update -> DisableInterrupt
            }
        }
        operator T() const {
            Atomic::DisableInterruptsRestore di;
            return mValue;
        }
        operator T() const volatile {
            Atomic::DisableInterruptsRestore di;
            return mValue;
        }
    private:
        T mValue{0}; 
    };
    
    template<>
    class atomic<uint8_t> {
    public:
        constexpr atomic() = default;

//        atomic(const atomic&);
        void operator=(const atomic &) = delete;

        void operator=(const uint8_t v) {
            mValue = v;
        }
        template<typename T = void>
        void operator++() {
            if constexpr(std::is_same_v<T, std::UnSafe>) {
                ++mValue; 
            }
            else {
                Atomic::DisableInterruptsRestore di;
                ++mValue; // <> read-modify-write: possible lost-update -> DisableInterrupts
            }
        }
        template<typename T = void>
        void operator++() volatile {
            if constexpr(std::is_same_v<T, std::UnSafe>) {
                mValue = mValue + 1; 
            }
            else {
                Atomic::DisableInterruptsRestore di;
                mValue = mValue + 1; 
            }
        }
        operator uint8_t() const {
            return mValue;
        }
        operator uint8_t() const volatile {
            return mValue;
        }
    private:
        uint8_t mValue{0}; // <> `volatile` ist falsch -> MemoryBarrier
    };

    template<typename T>
    void atomic_inc(T& v) {
        v.mValue += 1;
    }
    
    template<typename T>
    requires std::is_volatile_v<T>
    T atomic_volatile_load(const T& v) {
        using t = std::remove_cv_t<T>;
        if constexpr(sizeof(t) == 1) {
            return v;
        }
        else {
            Atomic::DisableInterruptsRestore di;
            return v;
        }
    }
    template<typename T>
    requires std::is_volatile_v<T>
    void atomic_volatile_store(T& v, const std::remove_volatile_t<T> value) {
        using t = std::remove_cv_t<T>;
        if constexpr(sizeof(t) == 1) {
            v = value;
        }
        else {
            Atomic::DisableInterruptsRestore di;
            v = value;
        }
    }
}

