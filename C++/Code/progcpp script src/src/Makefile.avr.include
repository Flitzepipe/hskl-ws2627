export LC_ALL=C

# Ohne AVR-Toolchain (z.B. Windows-Studenten-PC) die AVR-Ziele ueberspringen:
# 'targets' muss geleert werden, BEVOR 'all' die Voraussetzungen expandiert.
ifeq ($(shell command -v avr-g++ 2>/dev/null),)
targets :=
$(info Hinweis: keine AVR-Toolchain (avr-g++) gefunden -- AVR-Ziele werden uebersprungen)
endif

.PHONY: all clean subclean subdirs ${subdirs}

all: $(targets) subdirs

subdirs: ${subdirs}

${subdirs}:
	@if [ -d $@ ]; then ${MAKE} -C $@ all; fi

CCSRC = $(wildcard *.cc)
CCOBJ = $(patsubst %.cc, %.o, $(CCSRC))
CCDEP = $(patsubst %.cc, %.d, $(CCSRC))
CCASM = $(patsubst %.cc, %.s, $(CCSRC))

CSRC = $(wildcard *.c)
COBJ = $(patsubst %.c, %.o, $(CSRC))
CDEP = $(patsubst %.c, %.d, $(CSRC))
CASM = $(patsubst %.c, %.s, $(CSRC))

HSRC = $(wildcard *.h)

SRC += $(CCSRC) 
SRC += $(CSRC) 

OBJ += $(CCOBJ)
OBJ += $(COBJ)

ASM += $(CCASM)
ASM += $(CASM)

DEP += $(CCDEP)
DEP += $(CDEP)

MCUFLAGS = -mmcu=$(MCU)

SIMAVR = ~/Projekte/simavr/simavr/run_avr

AXTRACTOR = $(HOME)/Projekte/github/extractor/extract/axtractor
EXTRACTOR = $(HOME)/Projekte/github/extractor/extract/extractor
EXTRACTDIR = .extractor
EXTRACTDIRNC = .extractornc
EXLN = -n

SRCHI = source-highlight

cchtml = $(patsubst %.cc, %.cc.html, $(CCSRC))
chtml = $(patsubst %.c, %.c.html, $(CSRC))
hhtml = $(patsubst %.h, %.h.html, $(HSRC))
ahtml = $(patsubst %.s, %.s.html, $(ASM))
ahtml += $(patsubst %.s, %.S.html, $(ASM))

shtml: $(cchtml) $(chtml) $(hhtml) $(ahtml)

ahtml: $(ahtml)

#CPPFLAGS += -DNDEBUG

OPTFLAGS += -Os
ifndef OPTFLAGS
endif

CXXFLAGS += $(OPTFLAGS) -std=c++23  -pedantic 
#CXXFLAGS += -flto -fwhole-program
#CXXFLAGS += --param max-unroll-times=5
#CXXFLAGS += --param max-unrolled-insns=5
#CXXFLAGS += -O3 -std=c++17 # -pedantic
#CXXFLAGS += -nostdlib -fno-exceptions -fno-unwind-tables -fno-rtti -fno-threadsafe-statics
CXXFLAGS += -fno-exceptions -fno-unwind-tables -fno-rtti -fno-threadsafe-statics #-Wgnu-string-literal-operator-template
CXXFLAGS += -funsigned-char -funsigned-bitfields -fshort-enums 
#CXXFLAGS += --param=ipa-sra-ptr-growth-factor=6
#CXXFLAGS += -ffunction-sections  -fdata-sections # seperate sections -> see --gc-sections 
CXXFLAGS += -fconcepts
CXXFLAGS += -fstrict-aliasing -Wstrict-aliasing=1 
CXXFLAGS += -Wall -Wextra # -Waddr-space-convert # not for C++
CXXFLAGS += -DF_OSC=$(F_OSC) -DF_CPU=$(F_OSC)
CXXFLAGS += -I/usr/local/avr/avr/include
#CXXFLAGS += -I/usr/avr/include
CXXFLAGS += -I. -I../../include/avr/std
CXXFLAGS += -I../../include # -I../../../include
CXXFLAGS += -I/usr/include/simavr
CXXFLAGS += $(MCUFLAGS)
#CXXFLAGS += -fno-tree-switch-conversion
CXXFLAGS += --param=min-pagesize=0 # avr-gcc-12.1, avr-gcc-13.0  (doc0/bm00/bm00.cc)

CFLAGS += $(OPTFLAGS) -std=gnu11 -pedantic # wegen __flash
#CFLAGS += -Os -std=c11 -pedantic
#CFLAGS += -flto -fwhole-program
CFLAGS += -funsigned-char -funsigned-bitfields -fshort-enums
CFLAGS += -Wall -Wextra -Waddr-space-convert 
CFLAGS += -fstrict-aliasing -Wstrict-aliasing=1
CFLAGS += --param=min-pagesize=0 
CFLAGS += -DF_OSC=$(F_OSC) -DF_CPU=$(F_OSC)
CFLAGS += -I/usr/local/avr/avr/include
#CFLAGS += -I/usr/avr/include
CFLAGS += -I. -I../../include
CFLAGS += -I../include
CFLAGS += -I/usr/include/simavr
CFLAGS += $(MCUFLAGS)

ASMFLAGS += -fverbose-asm 
ASMFLAGS +=  -Wa,-adhlns 

LDFLAGS = $(MCUFLAGS) -Wl,-Map=main.map,--cref # -Wl,--gc-sections # remove unused function (s.a. byte.h) 
#LDFLAGS += "-Wl,--undefined=_mmcu,--section-start=.mmcu=0x910000" # simavrconsole.c
LDFLAGS += "-Wl,--section-start=.mmcu=0x910000"
#LDFLAGS += -latomic

AVRDUDE_PROGRAMMER = avrisp2
AVRDUDE_PORT = usb
AVRDUDE_NO_VERIFY = -V
AVRDUDE_FLAGS = -p $(MCU) -P $(AVRDUDE_PORT) -c $(AVRDUDE_PROGRAMMER)
AVRDUDE_FLAGS += $(AVRDUDE_NO_VERIFY)
AVRDUDE_FLAGS += $(AVRDUDE_VERBOSE)
AVRDUDE_FLAGS += $(AVRDUDE_ERASE_COUNTER)
AVRDUDE_FLAGS += -C+/home/lmeier/Projekte/wmucpp/avrdude.conf

#CC = /usr/local/bin/avr-gcc
#CXX = /usr/local/bin/avr-g++
CC = /usr/bin/avr-gcc
CXX = /usr/bin/avr-g++
OBJCOPY = avr-objcopy
OBJDUMP = avr-objdump
SIZE = avr-size
NM = avr-nm
AVRDUDE = avrdude
LD = avr-ld

%.s: %.cc
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(ASMFLAGS) -S -o $@ $<

%.s: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(ASMFLAGS) -S -o $@ $<

%.size: %.elf
	avr-size $< > $@

# Program the device.  
%.pgr: %.hex %.eep
	$(AVRDUDE) $(AVRDUDE_FLAGS) -U flash:w:$< $(AVRDUDE_WRITE_EEPROM)

# Create final output files (.hex, .eep) from ELF output file.
%.hex: %.elf
	$(OBJCOPY) -O ihex -R .eeprom $< $@

%.eep: %.elf
	-$(OBJCOPY) -j .eeprom --set-section-flags=.eeprom="alloc,load" \
	--change-section-lma .eeprom=0 -O ihex $< $@

# Create extended listing file from ELF output file.
%.lss: %.elf
	$(OBJDUMP) -C -h -S $< > $@

# Create a symbol table from ELF output file.
%.sym: %.elf
	$(NM) -n $< > $@

%.elf: %.cc
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $< --output $@ $(LDFLAGS) $(LOADLIBES)

%.elf: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $< --output $@ $(LDFLAGS)

%.hex: %.elf
	$(OBJCOPY) -O ihex -R .eeprom $< $@

%.d: %.cc
	$(CXX) -MM -MG $(CXXFLAGS) $< | sed 's/$*\.o/& $@ $*.elf $<.extract/g' > $@

%.S: %.s
	cat $< | c++filt | grep -v "^[ \t]*;" | grep -v "^[ \t]*\/\*.*\*\/$$" | grep -v "^[ \t]*__[Stz]" | grep -v "^\.L__" | grep -v "^.L[FV]" | grep -v "^\s*\.[fgi]" | grep -v "^[ \t]*$$" > $@
	#cat $< | grep -v "^#" | grep -v "^[ \t]*$$" | grep -v "[ \t]*\.cfi_" | grep -v "^\.L[A-Z][A-Z]" > $@


%.s.axtract: %.s
	$(AXTRACTOR) $(EXLN) -o $@ $<

%.S.axtract: %.S
	$(AXTRACTOR) $(EXLN) -o $@ $<

%.cc.extract: %.cc
	$(EXTRACTOR) $(EXLN) -l cpp -a A2 -a N -o $@ -d $(EXTRACTDIR) $<

%.c.extract: %.c
	$(EXTRACTOR) $(EXLN) -l c -a A2 -o $@ -d $(EXTRACTDIR) $<

%.h.extract: %.h
	$(EXTRACTOR) $(EXLN) -l cpp -a A2 -a N -o $@ -d $(EXTRACTDIR) $<

%.extract: %
	$(EXTRACTOR) $(EXLN) -l cpp -a A2 -a N -o $@ -d $(EXTRACTDIR) $<

%.java.extract: %.java
	$(EXTRACTOR) $(EXLN) -l java -a A2 -o $@ -d $(EXTRACTDIR) $<

%.cc.extractnc: %.cc
	$(EXTRACTOR) $(EXLN) -l cpp -a A2 -a N --skip-callouts -d $(EXTRACTDIRNC) -o $@ $<

%.h.extractnc: %.h
	$(EXTRACTOR) $(EXLN) -l cpp -a A2 -a N --skip-callouts -d $(EXTRACTDIRNC) -o $@ $<

%.java.extractnc: %.java
	$(EXTRACTOR) $(EXLN) -l java -a A2 --skip-callouts -d $(EXTRACTDIRNC) -o $@ $<

%.cc.html: %.cc
	$(EXTRACTOR) -x --enable-block-comments --include-omitted $< | $(SRCHI) -scpp > $@

%.c.html: %.c
	$(EXTRACTOR) -x --enable-block-comments --include-omitted $< | $(SRCHI) -scpp > $@

%.h.html: %.h
	$(EXTRACTOR) -x --enable-block-comments --include-omitted $< | $(SRCHI) -scpp > $@

%.java.html: %.java
	$(EXTRACTOR) -x --enable-block-comments --include-omitted  $< | $(SRCHI) -sjava > $@

%.s.html: %.s
	$(SRCHI) -sasm -i $< -o $@

%.S.html: %.S
	$(SRCHI) -sasm -i $< -o $@

%.out: %
	./$< $(PARGS) > $@

%.aout: %
	echo -n ".{output-caption} {counter:output}. Ausgabe des Programms: \`" > $@
	echo -n $< >> $@
	echo "\`" >> $@
	echo "[role=\"output\"]" >> $@
	echo "...." >> $@
	-SIMPLETEST=${SIMPLETEST} ./$< $(PARGS) >> $@ 2>&1
	echo "...." >> $@

%.aout2: %
	echo -n ".{output-caption} {counter:output}. Ausgabe des Programms: \`" > $@
	echo -n $< >> $@
	echo "\`" >> $@
	echo "[role=\"output\"]" >> $@
	echo "...." >> $@
	-SIMPLETEST=${SIMPLETEST} ./$< $(PARGS) >> $@ 2>/dev/null
	echo "...." >> $@

subclean:
	@for d in ${subdirs}; do \
		if [ -d $$d ]; then \
			${MAKE} -C $$d clean; \
		fi \
	done

clean:	subclean
	$(RM) $(targets)
	$(RM) $(OBJ)
	$(RM) $(DEP)
	$(RM) $(ASM)
	$(RM) *.hex
	$(RM) *.elf
	$(RM) *.map
	$(RM) *.lss
	$(RM) *.eep
	$(RM) *.size
	$(RM) *.html


-include $(DEP)

